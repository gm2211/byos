    "test": "npm run build"
  },
  "peerDependencies": {
    "express": "^4.18.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "8.18.1",
    "express": "^4.18.2",
    "typescript": "^5.9.3",
    "ws": "8.21.3"
  }
}
