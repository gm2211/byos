    },
    {
      "model": "claude-haiku-4-5",
      "acceptsTemperature": true,
      "thinksByDefault": false
    },
    {
      "model": "claude-sonnet-4-20250514",
      "acceptsTemperature": true,
      "thinksByDefault": false
    },
    {
      "model": "claude-3-5-sonnet-20241022",
      "acceptsTemperature": true,
      "thinksByDefault": false
    },
    {
      "model": "claude-3-haiku-20240307",
      "acceptsTemperature": true,
