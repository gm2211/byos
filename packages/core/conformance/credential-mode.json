{
  "description": "Credential mode vectors shared by @byos/core (TypeScript) and ByosCore (Swift). Providers list sign-in method kinds in declared order.",
  "modes": ["subscription-and-api-key", "subscription", "api-key"],
  "default": "subscription-and-api-key",
  "methodKinds": {
    "device-code": "subscription",
    "pkce": "subscription",
    "paste-token": "subscription",
    "api-key": "api-key"
  },
  "parse": [
    { "input": "subscription", "expect": "subscription" },
    { "input": "api-key", "expect": "api-key" },
    { "input": "subscription-and-api-key", "expect": "subscription-and-api-key" },
    { "input": "Subscription", "expect": "subscription-and-api-key" },
    { "input": "", "expect": "subscription-and-api-key" },
    { "input": null, "expect": "subscription-and-api-key" }
  ],
  "allows": {
    "subscription-and-api-key": ["subscription", "api-key"],
    "subscription": ["subscription"],
    "api-key": ["api-key"]
  },
  "providers": [
    { "id": "claude", "signIn": ["pkce", "paste-token", "api-key"] },
    { "id": "chatgpt", "signIn": ["device-code"] },
    { "id": "grok", "signIn": ["device-code", "api-key"] },
    { "id": "openrouter", "signIn": ["pkce", "api-key"] },
    { "id": "groq", "signIn": ["api-key"] },
    { "id": "mlx", "signIn": [] }
  ],
  "expect": {
    "subscription-and-api-key": [
      { "id": "claude", "signIn": ["pkce", "paste-token", "api-key"] },
      { "id": "chatgpt", "signIn": ["device-code"] },
      { "id": "grok", "signIn": ["device-code", "api-key"] },
      { "id": "openrouter", "signIn": ["pkce", "api-key"] },
      { "id": "groq", "signIn": ["api-key"] },
      { "id": "mlx", "signIn": [] }
    ],
    "subscription": [
      { "id": "claude", "signIn": ["pkce", "paste-token"] },
      { "id": "chatgpt", "signIn": ["device-code"] },
      { "id": "grok", "signIn": ["device-code"] },
      { "id": "openrouter", "signIn": ["pkce"] },
      { "id": "mlx", "signIn": [] }
    ],
    "api-key": [
      { "id": "claude", "signIn": ["api-key"] },
      { "id": "grok", "signIn": ["api-key"] },
      { "id": "openrouter", "signIn": ["api-key"] },
      { "id": "groq", "signIn": ["api-key"] },
      { "id": "mlx", "signIn": [] }
    ]
  }
}
