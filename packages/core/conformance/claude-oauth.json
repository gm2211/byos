    "oauthBeta": "oauth-2025-04-20,claude-code-20250219",
    "claudeCodeSystemPrefix": "You are Claude Code, Anthropic's official CLI for Claude.",
    "refreshWindowSeconds": 60,
    "defaultLifetimeSeconds": 3600
