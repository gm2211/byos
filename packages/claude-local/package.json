{
  "name": "@byos/claude-local",
  "version": "0.1.0",
  "description": "Node-only Claude Pro/Max subscription OAuth client: Keychain storage, direct HTTPS, loopback callback with a paste-code fallback.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "byos": {
    "runtime": "node"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
